; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Broken Provinces"
config/description="PS1-style action RPG - Broken Provinces: The Empty Throne"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
WorldGrid="*res://scripts/core/world_grid.gd"
WorldForgeImporter="*res://scripts/world/streaming/world_forge_importer.gd"
PlayerGPS="*res://scripts/world/streaming/player_gps.gd"
CellStreamer="*res://scripts/world/streaming/cell_streamer.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
CombatManager="*res://scripts/systems/combat/combat_manager.gd"
InventoryManager="*res://scripts/systems/economy/inventory_manager.gd"
FlagManager="*res://scripts/core/flag_manager.gd"
WorldState="*res://scripts/core/world_state.gd"
QuestManager="*res://scripts/systems/quests/quest_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
LootTables="*res://scripts/core/loot_tables.gd"
RestManager="*res://scripts/systems/events/rest_manager.gd"
DiceManager="*res://scripts/core/dice_manager.gd"
CraftingManager="*res://scripts/systems/economy/crafting_manager.gd"
DialogueManager="*res://scripts/systems/dialogue/dialogue_manager.gd"
ConversationSystem="*res://scripts/systems/dialogue/conversation_system.gd"
NPCScheduler="*res://scripts/characters/ai/npc_scheduler.gd"
BoatTravelManager="*res://scripts/systems/travel/boat_travel_manager.gd"
CrimeManager="*res://scripts/systems/crime/crime_manager.gd"
BountyManager="*res://scripts/systems/crime/bounty_manager.gd"
FastTravelManager="*res://scripts/systems/travel/fast_travel_manager.gd"
EncounterManager="*res://scripts/systems/events/encounter_manager.gd"
MoralityManager="*res://scripts/systems/factions/morality_manager.gd"
FactionManager="*res://scripts/systems/factions/faction_manager.gd"
CodexManager="*res://scripts/systems/quests/codex_manager.gd"
TakeoverManager="*res://scripts/systems/factions/takeover_manager.gd"
StatsTracker="*res://scripts/core/stats_tracker.gd"
JournalManager="*res://scripts/systems/quests/journal_manager.gd"
GameSystems="*res://scripts/core/game_systems.gd"
PostProcess="*res://scripts/core/post_process.gd"
EnchantmentManager="*res://scripts/systems/economy/enchantment_manager.gd"
SoulstoneEconomy="*res://scripts/systems/economy/soulstone_economy.gd"
SpellCreator="*res://scripts/systems/economy/spell_creator.gd"
TournamentManager="*res://scripts/systems/events/tournament_manager.gd"
ActorRegistry="*res://scripts/core/actor_registry.gd"
FollowerManager="*res://scripts/characters/ai/follower_manager.gd"
CaveManager="*res://scripts/world/streaming/cave_manager.gd"
DuelManager="*res://scripts/systems/events/duel_manager.gd"
EscortManager="*res://scripts/characters/ai/escort_manager.gd"
CompanionManager="*res://scripts/characters/ai/companion_manager.gd"
GuildRankManager="*res://scripts/systems/factions/guild_rank_manager.gd"
WeatherManager="*res://scripts/world/weather_manager.gd"
UIManager="*res://scripts/core/ui_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"

[editor]

movie_writer/ogv/encoding_speed=3
movie_writer/movie_file="C:/Users/caleb/CatacombsOfGore/dev/recordings/gameplaymovie.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dungeon_editor/plugin.cfg", "res://addons/level_editors/plugin.cfg", "res://addons/world_forge/plugin.cfg")

