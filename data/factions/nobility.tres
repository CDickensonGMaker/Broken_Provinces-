[resource]
script = ExtResource("1")
id = "nobility"
display_name = "The Noble Houses"
description = "The landed houses of the crumbling empire. With the throne empty twenty years they have stopped waiting for orders and started keeping their own soldiers, their own courts and their own quarrels. They pay well, they pay late, and they remember an insult longer than a debt."
parent_faction = "human_empire"
allies = ["human_empire", "town_guard", "iron_company"]
enemies = ["thieves_guild", "bandits"]
