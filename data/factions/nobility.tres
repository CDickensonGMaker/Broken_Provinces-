ranks = [{"name": "Attainted", "min_reputation": -100, "benefits": []}, {"name": "Beneath Notice", "min_reputation": -40, "benefits": []}, {"name": "Commoner", "min_reputation": 0, "benefits": []}, {"name": "Retained", "min_reputation": 30, "benefits": ["noble_contracts"]}, {"name": "Sworn Sword", "min_reputation": 55, "benefits": ["noble_contracts", "court_access"]}, {"name": "House Favourite", "min_reputation": 80, "benefits": ["noble_contracts", "court_access", "reduced_prices"]}, {"name": "Landed", "min_reputation": 95, "benefits": ["noble_contracts", "court_access", "reduced_prices", "estate_income"]}]
