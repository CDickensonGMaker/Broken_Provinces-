[resource]
script = ExtResource("1")
id = "larton"
display_name = "Larton"
description = "The southern port that feeds the relief road. Fishing quays, a grain wharf and a trade authority that decides, week by week, which starving town eats next. Larton's favour is measured in cargo manifests."
parent_faction = "human_empire"
allies = ["human_empire", "aberdeen", "dalhurst", "merchant_guild"]
enemies = ["bandits", "goblins"]
