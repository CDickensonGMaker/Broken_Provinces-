{
  "id": "tharin_ironbeard_wolves",
  "display_name": "Tharin Ironbeard - Wolf Problem Quest",
  "description": "Dialogue for Tharin Ironbeard offering the wolf hunting quest",
  "start_node": "wolf_problem",
  "nodes": [
    {
      "id": "wolf_problem",
      "speaker": "Tharin Ironbeard",
      "text": "Wolves are walking my logging roads in daylight now. One had Aldous Fenn by the leg two days back - he lived, but he won't go out with the crews again. That's one more man I can't spare before the snow. Thin them for me.",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "How many wolves are we talking about?",
          "next": "wolf_numbers",
          "conditions": [],
          "actions": []
        },
        {
          "text": "I'll take care of it.",
          "next": "accept_quest",
          "conditions": [],
          "actions": [
            {
              "type": "start_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        },
        {
          "text": "Why me?",
          "next": "why_me",
          "conditions": [],
          "actions": []
        },
        {
          "text": "I'm not interested in hunting wolves.",
          "next": "refuse",
          "conditions": [],
          "actions": []
        }
      ]
    },
    {
      "id": "wolf_numbers",
      "speaker": "Tharin Ironbeard",
      "text": "Five would do it. That's enough to teach the rest that this road costs them something.",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "I'll hunt them.",
          "next": "accept_quest",
          "conditions": [],
          "actions": [
            {
              "type": "start_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        },
        {
          "text": "Where do I find them?",
          "next": "wolf_location",
          "conditions": [],
          "actions": []
        },
        {
          "text": "Too dangerous for me.",
          "next": "refuse",
          "conditions": [],
          "actions": []
        }
      ]
    },
    {
      "id": "why_me",
      "speaker": "Tharin Ironbeard",
      "text": "You carried a letter and you carried a shipment and neither went missing. That's more than I can say for some of the men on my own payroll.",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "Alright, I'll do it.",
          "next": "accept_quest",
          "conditions": [],
          "actions": [
            {
              "type": "start_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        },
        {
          "text": "What's the payment?",
          "next": "payment_question",
          "conditions": [],
          "actions": []
        },
        {
          "text": "Find someone else.",
          "next": "refuse",
          "conditions": [],
          "actions": []
        }
      ]
    },
    {
      "id": "wolf_location",
      "speaker": "Tharin Ironbeard",
      "text": "East and north of the camp, along the game trails. Don't chase a wounded one into the dark - the rest will be waiting where it went.",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "I'm ready for them.",
          "next": "accept_quest",
          "conditions": [],
          "actions": [
            {
              "type": "start_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        },
        {
          "text": "Any tips for fighting wolves?",
          "next": "combat_tips",
          "conditions": [],
          "actions": []
        },
        {
          "text": "Sounds too risky.",
          "next": "refuse",
          "conditions": [],
          "actions": []
        }
      ]
    },
    {
      "id": "combat_tips",
      "speaker": "Tharin Ironbeard",
      "text": "Keep your back to a tree so they can't get behind you. Block the lunge and cut on the way back. And leave the wounded ones - you're thinning the pack, not settling with it.",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "Good advice. I'll get it done.",
          "next": "accept_quest",
          "conditions": [],
          "actions": [
            {
              "type": "start_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        },
        {
          "text": "On second thought, this is too dangerous.",
          "next": "refuse",
          "conditions": [],
          "actions": []
        }
      ]
    },
    {
      "id": "payment_question",
      "speaker": "Tharin Ironbeard",
      "text": "Fifty gold and two healing potions. And I'll know what you're worth when the next thing comes up. Interested?",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "Deal. I'll hunt the wolves.",
          "next": "accept_quest",
          "conditions": [],
          "actions": [
            {
              "type": "start_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        },
        {
          "text": "Not worth the risk.",
          "next": "refuse",
          "conditions": [],
          "actions": []
        }
      ]
    },
    {
      "id": "accept_quest",
      "speaker": "Tharin Ironbeard",
      "text": "Good. Five, then come back here. If they get around you, walk out - I'd rather pay you late than dig a hole.",
      "is_end": true,
      "auto_continue": "",
      "choices": []
    },
    {
      "id": "quest_progress",
      "speaker": "Tharin Ironbeard",
      "text": "How's the wolf hunting going?",
      "is_end": false,
      "auto_continue": "",
      "choices": [
        {
          "text": "Still working on it.",
          "next": "still_hunting",
          "conditions": [
            {
              "type": "quest_state",
              "param": "tharins_wolf_problem",
              "value": 1
            }
          ],
          "actions": []
        },
        {
          "text": "I've killed the wolves.",
          "next": "quest_complete",
          "conditions": [
            {
              "type": "quest_state",
              "param": "tharins_wolf_problem",
              "value": 1
            }
          ],
          "actions": [
            {
              "type": "complete_quest",
              "param": "tharins_wolf_problem",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "id": "still_hunting",
      "speaker": "Tharin Ironbeard",
      "text": "Keep at it. Every wolf you kill makes the roads safer for everyone.",
      "is_end": true,
      "auto_continue": "",
      "choices": []
    },
    {
      "id": "quest_complete",
      "speaker": "Tharin Ironbeard",
      "text": "The crews went out this morning without arguing about it. Fifty gold and two potions, as agreed. There'll be more work.",
      "is_end": true,
      "auto_continue": "",
      "choices": []
    },
    {
      "id": "refuse",
      "speaker": "Tharin Ironbeard",
      "text": "Suit yourself. If you change your mind, let me know. The wolves aren't going anywhere.",
      "is_end": true,
      "auto_continue": "",
      "choices": []
    }
  ]
}
